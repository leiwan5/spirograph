{
  "name": "@spirograph/core",
  "version": "0.1.2",
  "description": "Cross-platform spirograph pattern generation core: pure-math curve sampling, geometry transforms, segment-level render data, SVG/PNG serialization, zero DOM/Node dependencies",
  "homepage": "https://leiwan5.github.io/spirograph/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leiwan5/spirograph.git"
  },
  "bugs": {
    "url": "https://github.com/leiwan5/spirograph/issues"
  },
  "author": "Lei Wang <cnkknd@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "pako": "^3.0.1"
  },
  "keywords": [
    "spirograph",
    "hypotrochoid",
    "epitrochoid",
    "generative-art",
    "canvas",
    "svg",
    "png"
  ]
}
