{
  "name": "spirograph-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:packages && tsc && vite build",
    "build:packages": "tsc -b packages/core packages/anim",
    "build:cli": "tsc -b apps/cli",
    "preview": "vite preview",
    "test": "npm run build:packages && vitest run",
    "test:watch": "vitest",
    "check:purity": "node scripts/check-core-purity.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
